{
  "name": "@umituz/web-virtual",
  "version": "2.7.1",
  "description": "Universal 3D Virtual Environment Engine for Web & React — Offices, Farms, Factories, Schools, Hospitals with 60fps performance, raycasting and interactive entities.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./engine": "./src/engine/index.ts",
    "./entities": "./src/entities/index.ts",
    "./presets": "./src/presets/index.ts",
    "./components": "./src/components/index.ts",
    "./styles.css": "./src/styles/virtual.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || ^19.0.0",
    "react-dom": ">=18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "3d",
    "threejs",
    "virtual-environment",
    "virtual-office",
    "digital-hq",
    "interactive-world",
    "digital-twin",
    "react",
    "typescript",
    "simulation",
    "isometric",
    "metaverse"
  ],
  "author": "umituz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-virtual.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-virtual/issues"
  },
  "homepage": "https://github.com/umituz/web-virtual#readme"
}
